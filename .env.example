# Copy to .env (gitignored) and fill in. The CLI does not auto-load this
# file; these are documented for your own shell setup, e.g.:
#   export $(grep -v '^#' .env | xargs)
#
# On Windows, run_link_checker.ps1 reads the same settings from secrets.ps1
# instead -- see secrets.ps1.example.

# Substack session cookie (substack.sid). Treat like a password.
# Get it from your browser DevTools -> Application -> Cookies after logging in.
# Read by `check` when --cookie is not passed.
SUBSTACK_COOKIE=

# --- Failure alerts, read by `python -m substack_link_checker.notify` -------
#
# Optional, but a scheduled run without them fails silently: "no broken links"
# and "the run died" look identical from the outside.

# The account that sends the alert.
NOTIFY_EMAIL=

# Its password. For Gmail this must be an App Password, not the account
# password -- accounts with 2FA reject the latter over SMTP.
NOTIFY_PASSWORD=

# Where the alert goes. Defaults to NOTIFY_EMAIL.
NOTIFY_TO=

# Any SMTP server works. Defaults to smtp.gmail.com:587 (STARTTLS).
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=
