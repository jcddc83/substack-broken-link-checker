# Copy this file to secrets.ps1 and fill it in. secrets.ps1 is gitignored.
#
# It is dot-sourced by run_link_checker.ps1, so it holds both configuration
# and credentials -- which is why none of either lives in that script.

# --- Configuration -----------------------------------------------------

# Your Substack. Required.
$env:SUBSTACK_URL = "https://YOUR-SUBSTACK.substack.com"

# Only needed if the run must reach paywalled or bot-protected posts. Get it
# from your browser's developer tools (Application -> Cookies) after signing
# in, and treat it like a password. Leave unset if you do not need it.
# $env:SUBSTACK_COOKIE = "s%3A..."

# --- Failure alerts ----------------------------------------------------
#
# Optional but strongly recommended for a scheduled run. Without these, a
# failed run is silent, and "no broken links this month" looks exactly like
# "the run died on its first post".

# The account that sends the alert.
$env:NOTIFY_EMAIL = "you@example.com"

# Its password. For Gmail this must be an App Password, not your account
# password -- accounts with 2FA reject the latter over SMTP.
$env:NOTIFY_PASSWORD = "your-app-password"

# Where the alert goes. Defaults to NOTIFY_EMAIL if unset.
# $env:NOTIFY_TO = "ops@example.com"

# Any SMTP server works. Defaults to Gmail.
# $env:NOTIFY_SMTP_HOST = "smtp.gmail.com"
# $env:NOTIFY_SMTP_PORT = "587"

# Seconds to wait on the SMTP server before giving up (default: 30). The
# alert runs inside a failure handler, so it must not hang there.
# $env:NOTIFY_SMTP_TIMEOUT = "30"
